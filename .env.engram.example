# Engram Cloud Configuration
# Copy this file to .env.local and fill in your credentials

# Enable cloud autosync (1 = enabled, 0 = disabled for local-only)
ENGRAM_CLOUD_AUTOSYNC=1

# Bearer token from Engram Cloud dashboard
ENGRAM_CLOUD_TOKEN=your_token_here

# Cloud server URL (self-hosted or Engram Cloud)
ENGRAM_CLOUD_SERVER=https://cloud.engram.ai

# Override data directory (default: ~/.engram)
# ENGRAM_DATA_DIR=~/.engram

# Override HTTP server port (default: 7437)
# ENGRAM_PORT=7437

# Project override for MCP server
# ENGRAM_PROJECT=portfolio
