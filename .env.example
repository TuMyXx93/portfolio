# ===================================
# PORTFOLIO PROJECT - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env.local and fill in your values
# ===================================

# Application Configuration
NEXT_PUBLIC_APP_NAME=Portfolio Tumidev
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development/Production Environment
NODE_ENV=development

# Social Media Links
NEXT_PUBLIC_GITHUB_URL=https://github.com/Tumi-dev
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_EMAIL=contact@tumidev.com

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CONTACT_FORM=true
